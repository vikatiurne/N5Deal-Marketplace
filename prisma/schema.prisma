generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AssetStatus {
  DRAFT
  PUBLISHED
  PAUSED
  REMOVED
}

enum LicenseType {
  EMI
  PI
  MICA_CASP
  VASP
  BANK
  OTHER
}

/// Moderation actions a manager can perform. Closed set — the audit log must
/// never contain free-text actions.
enum AuditAction {
  USER_SUSPENDED
  USER_REACTIVED
  USER_SOFT_DELETED
  ASSET_PUBLISHED
  ASSET_PAUSED
  ASSET_REMOVED
}

enum AuditTargetType {
  USER
  ASSET
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  passwordHash String
  role        Role
  status      UserStatus @default(ACTIVE)
  displayName String
  company     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  profile       BuyerProfile?
  assets        Asset[]
  inquiriesSent Inquiry[]
  auditEntries  AuditLog[]
}

model BuyerProfile {
  userId       String @id
  // SQLite has no array type: JSON-encoded string, parsed in the repo layer.
  jurisdictions String
  licenseTypes  String
  budgetMin     Int?
  budgetMax     Int?
  description   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id            String      @id @default(cuid())
  sellerId      String
  title         String
  licenseType   LicenseType
  jurisdiction  String
  price         Int?
  currency      String      @default("EUR")
  description   String
  status        AssetStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  seller    User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  inquiries Inquiry[]

  @@index([status])
  @@index([sellerId])
}

model Inquiry {
  id        String    @id @default(cuid())
  assetId   String
  buyerId   String
  /// Direction: BUYER = buyer contacted seller, SELLER = seller contacted buyer.
  initiatorRole Role    @default(BUYER)
  message   String
  /// Set by the receiving party (seller) when the inquiry is opened.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  // One message per direction per (asset, buyer): a buyer inquiry and a seller
  // reply about the same asset can coexist, but neither side can double-post.
  @@unique([assetId, buyerId, initiatorRole])
  @@index([buyerId])
  @@index([assetId])
  @@index([initiatorRole])
}

/// Append-only trail of manager moderation actions. Never updated or deleted by
/// application code — `actorId` points at the manager who acted.
model AuditLog {
  id         String          @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType AuditTargetType
  targetId   String
  /// JSON-encoded string (SQLite has no JSON type), e.g. {"from":"ACTIVE"}.
  meta       String?
  createdAt  DateTime        @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}
