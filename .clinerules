❌ Не создавай новый репозиторий/файл, если можно расширить существующий

Полезные паттерны
Server action с guards + Zod
ts
'use server';
import { requireRole } from '@/lib/auth/guards';
import { inquirySchema } from '@/lib/validation/inquiry';
import { createInquiry } from '@/lib/db/repositories/inquiries';
import { revalidatePath } from 'next/cache';

export async function createInquiryAction(input: unknown) {
  const user = await requireRole('BUYER');
  const data = inquirySchema.parse(input);
  try {
    await createInquiry({ buyerId: user.id, ...data });
  } catch (e) {
    if (isPrismaUniqueError(e)) {
      return { ok: false, error: 'Inquiry already sent' };
    }
    throw e;
  }
  revalidatePath('/buyer/inquiries');
  revalidatePath(`/assets/${data.assetId}`);
  return { ok: true };
}
Zod schema для фильтров из URL
ts
export const assetFiltersSchema = z.object({
  licenseType: z.array(z.nativeEnum(LicenseType)).optional(),
  jurisdiction: z.array(z.string().length(2)).optional(),
  priceMin: z.coerce.number().int().positive().optional(),
  priceMax: z.coerce.number().int().positive().optional(),
  q: z.string().max(200).optional(),
  sort: z.enum(['newest', 'price_asc', 'price_desc']).default('newest'),
  page: z.coerce.number().int().min(1).default(1),
});
Repository — единая точка доступа к БД
ts
// lib/db/repositories/assets.ts
export async function listAssets(filters: AssetFilters) {
  const where = buildWhere(filters);
  const [items, total] = await Promise.all([
    prisma.asset.findMany({ where, skip, take, orderBy }),
    prisma.asset.count({ where }),
  ]);
  return { items: items.map(toDomain), total };
}
Активируй эти правила в начале каждой сессии.
