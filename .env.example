# Prisma — SQLite for dev (swap to Postgres by changing the URL)
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=""

# AI smart search (Task 08) — all optional, the app falls back to keyword search
OPENAI_API_KEY=""
# Model used for query parsing. Default: gpt-4o-mini (cheapest model good at JSON)
OPENAI_MODEL="gpt-4o-mini"
# Point at any OpenAI-compatible gateway (Azure, proxy, local mock in E2E checks)
OPENAI_BASE_URL="https://api.openai.com/v1"
